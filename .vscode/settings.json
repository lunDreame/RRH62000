{
    "idf.port": "/dev/cu.usbserial-0001",
    "idf.baudRate": 115200,
    "idf.flashType": "UART",
    "idf.monitorBaudRate": 115200,
    "idf.openOcdConfigs": [
        "board/esp-wroom-32.cfg"
    ],
    "idf.toolsPath": "${env:HOME}/.espressif",
    "idf.gitPath": "git",
    "idf.pythonBinPath": "python3",
    "idf.espIdfPath": "${env:HOME}/tools/esp-idf",
    "idf.espMatterPath": "${env:HOME}/tools/esp-matter",
    "idf.customExtraPaths": "",
    "idf.customExtraVars": {},
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.errorSquiggles": "enabled",
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/build": true,
        "**/sdkconfig.old": true,
        "**/dependencies.lock": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/build": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/build/**": true
    },
    "files.encoding": "utf8",
    "files.eol": "\n",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false,
    "terminal.integrated.env.osx": {
        "PATH": "${env:PATH}"
    },
    "terminal.integrated.env.linux": {
        "PATH": "${env:PATH}"
    },
    "terminal.integrated.env.windows": {
        "PATH": "${env:PATH}"
    },
    "files.associations": {
        "array": "cpp",
        "string": "cpp",
        "string_view": "cpp",
        "span": "cpp",
        "vector": "cpp",
        "iterator": "cpp"
    }
}